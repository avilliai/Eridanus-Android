<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- 机器人消息 -->
    <LinearLayout
        android:id="@+id/layoutBotMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top|start"
        android:visibility="gone">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/avatar_round"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/tvBotName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eridanus"
                android:textSize="11sp"
                android:textColor="#8D6E63"
                android:layout_marginBottom="2dp" />

            <!-- 文本气泡：仅在有文本时显示，带气泡背景 -->
            <TextView
                android:id="@+id/tvBotText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="260dp"
                android:background="@drawable/bg_msg_bot"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="#3E2723"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <!-- 独立图片卡片：无气泡背景，向左与文本气泡起始处对齐，四周带圆角剪裁 -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivBotImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="220dp"
                android:maxHeight="320dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ChatImageRoundedCorners" />

        </LinearLayout>
    </LinearLayout>

    <!-- 用户消息 -->
    <LinearLayout
        android:id="@+id/layoutUserMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top|end"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <!-- 文本气泡：仅在有文本时显示，带用户气泡背景 -->
            <TextView
                android:id="@+id/tvUserText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="260dp"
                android:background="@drawable/bg_msg_user"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <!-- 独立图片卡片：无气泡背景，靠右对齐，四周带圆角剪裁 -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivUserImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="200dp"
                android:maxHeight="280dp"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ChatImageRoundedCorners" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
